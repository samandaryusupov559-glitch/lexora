rules_version = '2';

// Daybook security rules.
// The teacher's email below must match TEACHER_EMAIL in config.js.
// Each student can read and write only their own journal; only the teacher reads every journal
// and only the teacher writes feedback.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'samandaryusupov559@gmail.com';
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Teachers of the centre (not the owner): the owner lists their email in /staff/{email}.
    // They count only after they confirm their email.
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email.lower());
    }
    function isStaff() {
      return signedIn() && request.auth.token.email_verified == true && exists(staffPath());
    }
    function staffTid() {
      return get(staffPath()).data.tid;
    }
    // A staff teacher who teaches this student: as their journal teacher or for confirmed extra lessons.
    function teachesUid(uid) {
      return isStaff()
        && ((exists(/databases/$(database)/documents/journals/$(uid))
              && get(/databases/$(database)/documents/journals/$(uid)).data.get('teacher', 'main') == staffTid())
            || (exists(/databases/$(database)/documents/enrollStatus/$(uid))
              && get(/databases/$(database)/documents/enrollStatus/$(uid)).data.get(staffTid(), '') == 'ok'));
    }
    // The staff teacher this student chose (journals without a teacher belong to the owner).
    function teachesJournal(uid) {
      return isStaff() && get(/databases/$(database)/documents/journals/$(uid)).data.get('teacher', 'main') == staffTid();
    }

    // A student's journal: profile document + entries.
    // The student picks a teacher when they start; only the owner can move them to another teacher.
    function profileTextOk(d) {
      return (!('photo' in d) || (d.photo is string && d.photo.size() <= 150000))
        && (!('about' in d) || (d.about is string && d.about.size() <= 600))
        && (!('goal' in d) || (d.goal is string && d.goal.size() <= 200))
        && (!('city' in d) || (d.city is string && d.city.size() <= 60))
        && (!('interests' in d) || (d.interests is string && d.interests.size() <= 200));
    }
    match /journals/{uid} {
      allow read: if isMe(uid) || isTeacher() || (isStaff() && resource.data.teacher == staffTid());
      // a new journal always names its teacher, so nobody lands with the owner by default
      allow create: if isTeacher() || (isMe(uid) && request.resource.data.get('teacher', '') is string && request.resource.data.get('teacher', '').size() > 0
        && request.resource.data.get('trial', true) == true && profileTextOk(request.resource.data));
      // the student leaves, or their teacher removes them: they start again by choosing a teacher
      allow delete: if isMe(uid) || isTeacher() || teachesJournal(uid);
      // a student edits their own profile text and photo but never the trial flag; a staff teacher may only accept a trial student
      allow update: if isTeacher()
        || (isMe(uid) && request.resource.data.get('teacher', 'main') == resource.data.get('teacher', 'main')
            && request.resource.data.get('trial', false) == resource.data.get('trial', false) && profileTextOk(request.resource.data))
        || (teachesJournal(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trial', 'acceptedAt']));
      match /entries/{eid} {
        allow read: if isMe(uid) || isTeacher() || teachesJournal(uid);
        allow write: if isMe(uid) || isTeacher();
        allow delete: if teachesJournal(uid);
      }
    }
    // A student who left or was removed: the owner's page deletes the rest of their data, then this note.
    match /leaves/{uid} {
      allow create, update: if (isMe(uid) || teachesJournal(uid))
        && request.resource.data.keys().hasOnly(['at', 'by', 'name']) && request.resource.data.at is int
        && request.resource.data.by in ['s', 't'] && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow read, delete: if isTeacher();
    }

    // Teacher's feedback: the student may read their own, only the teacher writes.
    match /feedback/{uid} {
      allow read: if isMe(uid) || isTeacher() || teachesJournal(uid);
      allow write: if isTeacher() || teachesJournal(uid);
      match /reviews/{eid} {
        allow read: if isMe(uid) || isTeacher() || teachesJournal(uid);
        allow write: if isTeacher() || teachesJournal(uid);
      }
    }

    // Prompt of the week: every signed-in student reads it, only the teacher sets it.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // Teacher's private comment bank.
    match /teacher/{doc} {
      allow read, write: if isTeacher() || (isStaff() && doc == 'prefs-' + staffTid());
    }

    // Payments (tuition ledger): students, payments and lesson-price settings. Only the teacher.
    match /ledger/{document=**} {
      allow read, write: if isTeacher();
    }

    // Each student's own balance, copied from the ledger by the teacher's page.
    // The student may read only their own; only the teacher writes.
    match /balances/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }

    // Noticeboard (announcements + posts) and the list of extra lessons / free times.
    // Every signed-in student reads them; only the teacher writes.
    match /board/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // Each student's tasks and "what to learn" list. The teacher writes the list;
    // the student may only tick items off (change the "done" field, nothing else).
    match /plans/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is map;
    }

    // A student's booking requests. The student writes only their own;
    // whether a request is confirmed lives in bookingStatus, which only the teacher writes.
    match /bookings/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid)
            && request.resource.data.keys().hasOnly(['name', 'items'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 50);
    }
    // "I paid" reports. A student may write only their own list; it changes nothing by itself.
    // The teacher checks their Click/Payme/bank app and only then adds the real payment to the ledger.
    match /payClaims/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid)
            && request.resource.data.keys().hasOnly(['name', 'items'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 50);
    }
    // Shop: everyone signed in sees the items; only the teacher changes them.
    match /market/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // A student's own orders. Whether the money arrived (and the teacher's message, e.g. a PDF link)
    // lives in orderStatus, which only the teacher writes.
    match /orders/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid)
            && request.resource.data.keys().hasOnly(['name', 'items'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 50);
    }
    match /orderStatus/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
    // Links to the files sold in the Shop. Only the owner sees them; a buyer gets their link in orderStatus.
    match /marketFiles/{doc} {
      allow read, write: if isTeacher();
    }
    // A student's email address for notifications. The student may only save their own sign-in
    // email, so nobody can make the teacher's Gmail write to a stranger.
    match /contacts/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid)
            && request.resource.data.keys().hasOnly(['email', 'lang', 'off'])
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.off is bool);
    }
    // Teacher-only settings, e.g. the link to the email script and its secret code.
    match /private/{doc} {
      allow read, write: if isTeacher();
    }
    match /payClaimStatus/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
    match /bookingStatus/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }

    // ---------- Premium products in the Shop: the daily newspaper and the practice pack ----------
    // Both are written by the teacher for each paying student personally.
    // Prices and settings: everyone signed in reads them.
    match /premium/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // Who may read what, and until when. Only the teacher writes it, after checking the money arrived.
    match /passes/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
    function paidUntil(kind) {
      return exists(/databases/$(database)/documents/passes/$(request.auth.uid))
        && get(/databases/$(database)/documents/passes/$(request.auth.uid)).data.get(kind, {}).get('until', 0) > request.time.toMillis();
    }
    // One student's newspaper issue for one day (id: uid_date). Only that student, only once it is out,
    // only while their subscription runs.
    match /newsDays/{id} {
      allow read: if isTeacher()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && request.time.toMillis() >= resource.data.releaseAt
            && paidUntil('news'));
      allow write: if isTeacher();
    }
    // One student's practice set: only that student, while their pack is open.
    match /study/{id} {
      allow read: if isTeacher()
        || (signedIn() && resource.data.uid == request.auth.uid && paidUntil('study'));
      allow write: if isTeacher();
    }
    // The list of a student's sets (titles only).
    match /studyIndex/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
    // "I paid" requests for the newspaper / the pack. Changes nothing by itself.
    match /passOrders/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid)
            && request.resource.data.keys().hasOnly(['name', 'items'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 50);
    }
    // A student's own quiz answers and flashcard progress.
    match /passScores/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid) && request.resource.data.keys().hasOnly(['name', 'news', 'study', 'cards']));
    }

    // ---------- Teaching centre ----------
    // Public teacher profiles. Guests see the ones marked visible; signed-in users see all.
    // A staff teacher may edit their own profile text and course prices, never their level, stats or visibility.
    // Price ranges come from site/pricing by teacher level; only the owner sets a teacher's level (plevel).
    match /teachers/{tid} {
      allow read: if resource.data.visible == true || signedIn();
      allow write: if isTeacher();
      allow update: if isStaff() && staffTid() == tid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'photo', 'headline', 'langs', 'levels', 'years', 'bio', 'achievements', 'lessonLen', 'services', 'lastSeen', 'prices', 'agreedAt'])
        && request.resource.data.get('prices', {}) is map && request.resource.data.get('prices', {}).size() <= 20;
    }
    // A teacher's gallery (extra photos + video links), kept apart from the profile so the landing page stays light.
    // Guests read the gallery of visible teachers; the owner writes any, a staff teacher only their own.
    match /teacherMedia/{tid} {
      allow read: if signedIn()
        || (exists(/databases/$(database)/documents/teachers/$(tid))
            && get(/databases/$(database)/documents/teachers/$(tid)).data.get('visible', false) == true);
      allow write: if isTeacher()
        || (isStaff() && staffTid() == tid
            && request.resource.data.keys().hasOnly(['photos', 'videos'])
            && request.resource.data.get('photos', []) is list && request.resource.data.get('photos', []).size() <= 6
            && request.resource.data.get('videos', []) is list && request.resource.data.get('videos', []).size() <= 6);
    }
    // A teacher's own Google Meet link: the owner, that teacher and that teacher's students.
    match /teacherPriv/{tid} {
      allow read: if isTeacher() || (isStaff() && staffTid() == tid)
        || (signedIn() && exists(/databases/$(database)/documents/journals/$(request.auth.uid))
            && get(/databases/$(database)/documents/journals/$(request.auth.uid)).data.get('teacher', 'main') == tid)
        || (signedIn() && exists(/databases/$(database)/documents/enrollStatus/$(request.auth.uid))
            && get(/databases/$(database)/documents/enrollStatus/$(request.auth.uid)).data.get(tid, '') == 'ok');
      allow write: if isTeacher()
        || (isStaff() && staffTid() == tid && request.resource.data.keys().hasOnly(['meet']));
    }
    // Who may sign in as a teacher of the centre. Only the owner adds people.
    match /staff/{email} {
      allow read: if isTeacher() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isTeacher();
    }
    // "Become a teacher" applications from visitors. Anyone may send one; only the owner reads them.
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'email', 'photo', 'langs', 'levels', 'years', 'lessonLen', 'bio', 'achievements', 'msg', 'at', 'prices', 'agree'])
        && request.resource.data.keys().hasAll(['name', 'contact', 'langs', 'years', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 120
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 300000
        && request.resource.data.langs is list && request.resource.data.langs.size() > 0 && request.resource.data.langs.size() <= 12
        && request.resource.data.get('levels', '') is string && request.resource.data.get('levels', '').size() <= 40
        && request.resource.data.years is int && request.resource.data.years >= 0 && request.resource.data.years <= 60
        && request.resource.data.get('lessonLen', 60) is int && request.resource.data.get('lessonLen', 60) >= 15 && request.resource.data.get('lessonLen', 60) <= 240
        && request.resource.data.get('bio', '') is string && request.resource.data.get('bio', '').size() <= 1500
        && request.resource.data.get('achievements', []) is list && request.resource.data.get('achievements', []).size() <= 20
        && request.resource.data.get('msg', '') is string && request.resource.data.get('msg', '').size() <= 500
        && request.resource.data.get('prices', {}) is map && request.resource.data.get('prices', {}).size() <= 12
        && request.resource.data.at is int;
      allow read, update, delete: if isTeacher();
    }
    // A student's requests to take lessons with more teachers; the owner answers in enrollStatus.
    match /enroll/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid) && request.resource.data.keys().hasOnly(['name', 'items'])
            && request.resource.data.items is list && request.resource.data.items.size() <= 20);
    }
    match /enrollStatus/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
    // Extra students of each teacher (written by the owner when they accept).
    match /roster/{tid} {
      allow read: if isTeacher() || (isStaff() && staffTid() == tid);
      allow write: if isTeacher();
    }
    // Public site settings, e.g. the discount for students with 2+ teachers.
    match /site/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // The teacher's own "lesson started" state (who it was sent to). Students read liveFor instead.
    match /live/{tid} {
      allow read: if isTeacher() || (isStaff() && staffTid() == tid);
      allow write: if isTeacher()
        || (isStaff() && staffTid() == tid && request.resource.data.keys().hasOnly(['on', 'at', 'until', 'url', 'to', 'label']));
    }
    // The lesson link for one student, per teacher. Only that student reads it; a teacher writes only their own key,
    // and only for their own students (journal teacher or confirmed extra lessons).
    match /liveFor/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (teachesUid(uid)
            && (resource == null
                  ? request.resource.data.keys().hasOnly([staffTid()])
                  : request.resource.data.diff(resource.data).affectedKeys().hasOnly([staffTid()])));
    }
    // Homework: the master copy is for teachers only; each student gets a copy in hwFor/{uid}
    // (written by teachers) and may change only the "done" map of their own copy.
    match /homework/{id} {
      allow read, delete: if isTeacher() || (isStaff() && resource.data.tid == staffTid());
      allow create: if isTeacher() || (isStaff() && request.resource.data.tid == staffTid());
      allow update: if isTeacher() || (isStaff() && resource.data.tid == staffTid() && request.resource.data.tid == staffTid());
    }
    match /hwFor/{uid} {
      allow read: if isMe(uid) || isTeacher() || isStaff();
      allow write: if isTeacher() || isStaff();
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is map;
    }
    // ---------- tests ----------
    // exams/{id}: the questions (with the answers). Teachers write; a student may read a published test
    // that is free or that the owner has opened for them (examAccess). examList/main is the catalogue without questions.
    function examPath(id) { return /databases/$(database)/documents/exams/$(id); }
    function hasExam(id) {
      return exists(/databases/$(database)/documents/examAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/examAccess/$(request.auth.uid)).data.get('ids', {}).get(id, null) != null;
    }
    function canTake(id) {
      return signedIn() && exists(examPath(id)) && get(examPath(id)).data.get('on', false) == true
        && (get(examPath(id)).data.get('price', 0) == 0 || hasExam(id));
    }
    match /exams/{id} {
      allow read: if isTeacher() || (isStaff() && resource.data.tid == staffTid())
        || (signedIn() && resource.data.on == true && (resource.data.get('price', 0) == 0 || hasExam(id)));
      allow create: if isTeacher() || (isStaff() && request.resource.data.tid == staffTid());
      allow update: if isTeacher() || (isStaff() && resource.data.tid == staffTid() && request.resource.data.tid == staffTid());
      allow delete: if isTeacher() || (isStaff() && resource.data.tid == staffTid());
    }
    match /examList/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher() || isStaff();
    }
    // Paid tests (IELTS, SAT…): the student sends "I paid", the owner opens the test.
    match /examAccess/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
    match /examOrders/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher()
        || (isMe(uid)
            && request.resource.data.keys().hasOnly(['name', 'items'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 50);
    }
    // One attempt per student and test. It starts now (the clock is checked), and answers are accepted
    // once, until the time is up (plus two minutes for a slow connection). The teacher may delete it for a retake.
    match /examRuns/{rid} {
      allow read: if isTeacher() || isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && rid == request.auth.uid + '_' + request.resource.data.examId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'examId', 'name', 'mins', 'startedAt'])
        && request.resource.data.startedAt is int
        && math.abs(request.resource.data.startedAt - request.time.toMillis()) < 120000
        && canTake(request.resource.data.examId)
        && request.resource.data.mins == get(examPath(request.resource.data.examId)).data.mins;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && !('submittedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'score', 'n', 'submittedAt'])
        && request.resource.data.answers is list
        && request.resource.data.score is int && request.resource.data.n is int
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.n
        && request.resource.data.submittedAt is int
        && math.abs(request.resource.data.submittedAt - request.time.toMillis()) < 120000
        && request.time.toMillis() <= resource.data.startedAt + (resource.data.mins * 60 + 120) * 1000;
      allow delete: if isTeacher();
    }
    // 1–5 marks: teachers mark students (stCrit), students rate their teachers (tCrit, owner only).
    match /stCrit/{uid} {
      allow read: if isMe(uid) || isTeacher() || isStaff();
      allow write: if isTeacher() || isStaff();
    }
    match /tCrit/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isMe(uid) && request.resource.data.keys().size() <= 20;
    }
    // A teacher's groups (for starting a lesson for a group).
    match /groups/{tid} {
      allow read, write: if isTeacher() || (isStaff() && staffTid() == tid);
    }
    // ---------- languages ----------
    // A teacher's languages come from teachers/{tid}.langs; a teacher without languages counts as an English teacher.
    function tDoc(t) { return /databases/$(database)/documents/teachers/$(t); }
    function teachesLang(t, l) {
      return (exists(tDoc(t)) && get(tDoc(t)).data.get('langs', []).hasAny([l]))
        || (l == 'English' && (!exists(tDoc(t)) || get(tDoc(t)).data.get('langs', []).size() == 0));
    }
    // A student studies a language with their journal teacher, or in extra lessons the owner confirmed (enrollStatus.langs).
    function studiesLang(l) {
      return signedIn()
        && ((exists(/databases/$(database)/documents/journals/$(request.auth.uid))
              && teachesLang(get(/databases/$(database)/documents/journals/$(request.auth.uid)).data.get('teacher', 'main'), l))
            || (exists(/databases/$(database)/documents/enrollStatus/$(request.auth.uid))
              && get(/databases/$(database)/documents/enrollStatus/$(request.auth.uid)).data.get('langs', []).hasAny([l])));
    }
    function staffLang(l) { return isStaff() && teachesLang(staffTid(), l); }
    function inLang(l) { return isTeacher() || staffLang(l) || studiesLang(l); }
    // Speaking clubs, one per language and day: club/{lang}_{day}. Only people who teach or study that language take part;
    // the owner sees every club.
    function clubLang(id) { return id.split('_')[0]; }
    match /club/{id} {
      allow read: if inLang(clubLang(id));
      allow write: if isTeacher() || staffLang(clubLang(id));
      match /msgs/{m} {
        allow read: if inLang(clubLang(id));
        allow create: if inLang(clubLang(id)) && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'mod'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.at is int
          && (request.resource.data.get('mod', false) == false || isTeacher() || staffLang(clubLang(id)));
        allow delete: if isTeacher() || staffLang(clubLang(id)) || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
    // Library: links to books, audio and videos, by language. People read the languages they teach or study
    // (they ask for one language at a time); teachers add in their own languages and edit only their own items.
    match /library/{id} {
      allow read: if inLang(resource.data.lang);
      allow create: if isTeacher() || (staffLang(request.resource.data.lang) && request.resource.data.by == staffTid());
      allow update: if isTeacher() || (isStaff() && resource.data.by == staffTid() && request.resource.data.by == staffTid() && staffLang(request.resource.data.lang));
      allow delete: if isTeacher() || (isStaff() && resource.data.by == staffTid());
    }
    // Orders for a teacher's own services. The student creates one; that teacher or the owner answers.
    match /torders/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'tid', 'svcId', 'title', 'price', 'note', 'at'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300
        && request.resource.data.tid is string && request.resource.data.tid.size() <= 40
        && request.resource.data.price is number && request.resource.data.at is int;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid)
        || (isStaff() && resource.data.tid == staffTid());
      allow update: if isTeacher()
        || (isStaff() && resource.data.tid == staffTid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
            && request.resource.data.st in ['ok', 'no', 'done']);
      allow delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid && !('st' in resource.data));
    }
    // Trial-lesson requests from visitors. Anyone may send one; only the owner and the chosen teacher read it.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'lang', 'level', 'tid', 'msg', 'at', 'fmt', 'quote'])
        && request.resource.data.get('fmt', '') in ['', 'group', 'ind']
        && request.resource.data.get('quote', '') is string && request.resource.data.get('quote', '').size() <= 80
        && request.resource.data.keys().hasAll(['name', 'contact', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 120
        && request.resource.data.get('lang', '') is string && request.resource.data.get('lang', '').size() <= 40
        && request.resource.data.get('level', '') is string && request.resource.data.get('level', '').size() <= 20
        && request.resource.data.get('tid', '') is string && request.resource.data.get('tid', '').size() <= 40
        && request.resource.data.get('msg', '') is string && request.resource.data.get('msg', '').size() <= 500
        && request.resource.data.at is int;
      allow read: if isTeacher() || (isStaff() && resource.data.tid == staffTid());
      allow update, delete: if isTeacher();
    }
    // ---------- chats ----------
    function chatLast() {
      return request.resource.data.get('lastText', '') is string && request.resource.data.get('lastText', '').size() <= 160
        && request.resource.data.get('lastAt', 0) is int;
    }
    function chatMsgOk() {
      return request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.at is int;
    }
    function lastByIs(who) {
      return !('lastBy' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastBy == who;
    }
    // Visitors chat with the centre before they sign up: gchat/{id}. The id is a long random secret kept in the
    // visitor's browser, so only that visitor and the centre can open the chat. Only the owner and the assigned teacher list chats.
    function gchatDoc(id) { return get(/databases/$(database)/documents/gchat/$(id)).data; }
    match /gchat/{id} {
      allow get: if true;
      allow list: if isTeacher() || (isStaff() && resource.data.tid == staffTid());
      allow create: if id.size() >= 20 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'contact', 'lang', 'tid', 'at', 'lastAt', 'lastBy', 'lastText'])
        && request.resource.data.keys().hasAll(['name', 'contact', 'tid', 'at', 'lastAt', 'lastBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 120
        && request.resource.data.get('lang', '') is string && request.resource.data.get('lang', '').size() <= 40
        && request.resource.data.tid is string && request.resource.data.tid.size() <= 40
        && request.resource.data.at is int && request.resource.data.lastBy == 'g' && chatLast();
      allow update: if isTeacher()
        || (isStaff() && resource.data.tid == staffTid() && chatLast()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastBy', 'lastText', 'rt']) && lastByIs('t'))
        || (chatLast() && request.resource.data.get('rg', 0) is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastBy', 'lastText', 'rg']) && lastByIs('g'));
      allow delete: if isTeacher();
      match /msgs/{m} {
        allow read: if true;   // reachable only through the secret chat id
        allow create: if chatMsgOk() && exists(/databases/$(database)/documents/gchat/$(id))
          && ((request.resource.data.by == 'g' && request.resource.data.keys().hasOnly(['name', 'text', 'at', 'by']))
              || (request.resource.data.by == 't' && signedIn() && request.resource.data.get('uid', '') == request.auth.uid
                  && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'by'])
                  && (isTeacher() || (isStaff() && gchatDoc(id).get('tid', '') == staffTid()))));
        allow delete: if isTeacher();
      }
    }
    // A student's private chat with one of their teachers: dm/{uid}_{tid}. It opens only once lessons have started:
    // the teacher is the student's journal teacher or confirmed for extra lessons. The owner sees every chat.
    function dmTeaches(uid, tid) {
      return (exists(/databases/$(database)/documents/journals/$(uid))
              && get(/databases/$(database)/documents/journals/$(uid)).data.get('teacher', 'main') == tid)
        || (exists(/databases/$(database)/documents/enrollStatus/$(uid))
            && get(/databases/$(database)/documents/enrollStatus/$(uid)).data.get(tid, '') == 'ok');
    }
    function dmDoc(id) { return get(/databases/$(database)/documents/dm/$(id)).data; }
    function dmFields() {
      return request.resource.data.uid is string && request.resource.data.tid is string && request.resource.data.tid.size() <= 40
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
        && chatLast();
    }
    match /dm/{id} {
      allow get: if signedIn() && (id.split('_')[0] == request.auth.uid || isTeacher() || (isStaff() && resource.data.tid == staffTid()));
      allow list: if isTeacher() || (isStaff() && resource.data.tid == staffTid());
      allow create: if signedIn() && dmFields()
        && ((request.resource.data.uid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.tid
             && request.resource.data.keys().hasOnly(['uid', 'tid', 'name', 'lastAt', 'lastBy', 'lastText', 'rs'])
             && request.resource.data.get('lastBy', 's') == 's'
             && dmTeaches(request.auth.uid, request.resource.data.tid))
            || (isTeacher() && id == request.resource.data.uid + '_' + request.resource.data.tid)
            // a teacher writes first to their own student
            || (isStaff() && request.resource.data.tid == staffTid() && id == request.resource.data.uid + '_' + request.resource.data.tid
                && request.resource.data.keys().hasOnly(['uid', 'tid', 'name', 'lastAt', 'lastBy', 'lastText', 'rt'])
                && request.resource.data.lastBy == 't' && dmTeaches(request.resource.data.uid, staffTid())));
      allow update: if signedIn() && dmFields()
        && request.resource.data.uid == resource.data.uid && request.resource.data.tid == resource.data.tid
        && (isTeacher()
            || (resource.data.uid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastAt', 'lastBy', 'lastText', 'rs']) && lastByIs('s'))
            || (isStaff() && resource.data.tid == staffTid()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastBy', 'lastText', 'rt']) && lastByIs('t')));
      allow delete: if isTeacher();
      match /msgs/{m} {
        allow read: if signedIn() && (isTeacher() || id.split('_')[0] == request.auth.uid || (isStaff() && dmDoc(id).tid == staffTid()));
        allow create: if signedIn() && chatMsgOk() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'by'])
          && ((request.resource.data.by == 's' && dmDoc(id).uid == request.auth.uid && dmTeaches(request.auth.uid, dmDoc(id).tid))
              || (request.resource.data.by == 't' && (isTeacher() || (isStaff() && dmDoc(id).tid == staffTid()))));
        allow delete: if isTeacher();
      }
    }
    // ---------- Telegram bot ----------
    // A one-time code the site makes when someone presses "Connect Telegram"; only the bot (server) reads it.
    match /tglink/{code} {
      allow create: if signedIn() && code.size() >= 20 && code.size() <= 60
        && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid && request.resource.data.at is int;
    }
    // Written by the bot when the person presses Start; they may see and remove their own link.
    match /tg/{uid} {
      allow read, delete: if isMe(uid) || isTeacher();
    }
    // A notice for students (noticeboard, tasks, payments, bookings, orders): the bot sends it to Telegram and deletes it.
    // Only teachers write one, signed with their own uid; the bot also checks that a staff teacher writes only to their own students.
    match /tgq/{id} {
      allow create: if (isTeacher() || isStaff())
        && request.resource.data.keys().hasOnly(['ev', 'uids', 'msg', 'btn', 'href', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.uids is list && request.resource.data.uids.size() > 0 && request.resource.data.uids.size() <= 1000
        && request.resource.data.msg is map && request.resource.data.ev is string;
    }
    // Services the centre offers its teachers. Teachers read them; only the owner changes them.
    match /centre/{doc} {
      allow read: if isTeacher() || isStaff();
      allow write: if isTeacher();
    }
    // A teacher's requests for those services. The answer lives in "st", which only the owner writes.
    match /staffReq/{tid} {
      allow read: if isTeacher() || (isStaff() && staffTid() == tid);
      allow write: if isTeacher()
        || (isStaff() && staffTid() == tid
            && request.resource.data.items is list && request.resource.data.items.size() <= 50
            && (resource == null
                  ? request.resource.data.keys().hasOnly(['name', 'items'])
                  : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'items'])));
    }
    // In-site video call: a teacher opens a room for their own lesson and names who may enter.
    // Passes (callToken) and the call log (callLog/, callMins/) are server-only.
    match /calls/{room} {
      allow read: if isTeacher() || (isStaff() && resource.data.tid == staffTid()) || (signedIn() && request.auth.uid in resource.data.uids);
      allow create, update: if room.size() >= 3 && room.size() <= 80
        && request.resource.data.keys().hasOnly(['tid', 'uids', 'label', 'at', 'until', 'by'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 60
        && request.resource.data.until is int && request.resource.data.until <= request.time.toMillis() + 90 * 24 * 3600 * 1000
        && request.resource.data.by == request.auth.uid
        && (isTeacher() || (isStaff() && request.resource.data.tid == staffTid() && (resource == null || resource.data.tid == staffTid())));
      allow delete: if isTeacher();
    }
    // Contact details of trial requests and visitors: the owner only (the shared docs keep none, see the bot).
    match /privContact/{id} {
      allow read: if isTeacher();
    }
    // Google Meet links for a student's booked lessons. Only the owner writes them.
    match /lessons/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow write: if isTeacher();
    }
  }
}
